{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "composio": {
      "type": "http",
      "url": "${COMPOSIO_MCP_URL}",
      "headers": {
        "x-api-key": "${COMPOSIO_API_KEY}"
      }
    },
    "robinhood-trading": {
      "type": "http",
      "url": "https://agent.robinhood.com/mcp/trading"
    }
  }
}
