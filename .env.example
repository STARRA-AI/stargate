ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# xAI Grok — Think Tank today; chat + Realtime voice target (see docs/HANDOFF.md)
# XAI_API_KEY also powers Eve voice (xAI TTS, voice "eve") via /api/tts.
XAI_API_KEY=
# PINNED — leave this on the versioned ID, not the grok-voice-latest alias.
# xAI repoints grok-voice-latest from Think Fast 1.0 to 2.0 on 2026-08-05,
# taking audio from $0.05/min to $0.08/min (docs.x.ai/docs/models, fetched
# 2026-07-31). The rate meter in src/lib/voice/voiceCost.ts assumes 1.0.
XAI_REALTIME_MODEL=grok-voice-think-fast-1.0
# Ara TTS voice override (default: ara). Options include eve, ara, rex, sal, leo.
XAI_TTS_VOICE=
# xAI Grok chat brain (OpenAI-compatible, base https://api.x.ai/v1, uses XAI_API_KEY).
# Slug resolved live from /models; override here. Verified default: grok-4.5
XAI_MODEL=
# Hosted free Kimi brain via Groq (OpenAI-compatible, base https://api.groq.com/openai/v1).
GROQ_API_KEY=
# Slug resolved live from /models; override here. Verified default: moonshotai/kimi-k2-instruct-0905
GROQ_MODEL=
# Gemini fallback key (process.env.GEMINI_API_KEY in src/lib/keys.ts).
GEMINI_API_KEY=
# Reserved/unused — no src/ references as of this writing.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local free brain (Ollama) — Fable-inspired reasoning on deepseek-r1
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default: qwen2.5:1.5b (best free HUD fit on 8GB). Optional: deepseek-r1:1.5b
OLLAMA_MODEL=qwen2.5:1.5b
# auto | ollama | anthropic | kimi | grok   (kimi = free hosted daily driver)
LLM_PROVIDER=auto
# set to 1 to prefer Ollama even when ANTHROPIC_API_KEY is set
OLLAMA_PRIORITY=1

# --- Colab Pro / MuseTalk lip-sync (optional; her face matches her xAI voice) ---
# Same interface + same xAI voice; only her FACE is upgraded from the reactive
# clip to a photoreal MuseTalk clip locked to her exact spoken audio.
# COLAB_LIPSYNC_URL: the *.gradio.live URL of the running Colab Pro MuseTalk
#   notebook (server-side; never sent to the browser). Empty = reactive face.
# COLAB_LIPSYNC_API: the notebook's gradio api_name (default "/render").
# NEXT_PUBLIC_LIPSYNC=1: turn the browser-side lip-sync path ON (off by default,
#   so the call behaves exactly as today until you opt in).
COLAB_LIPSYNC_URL=
COLAB_LIPSYNC_API=/render
NEXT_PUBLIC_LIPSYNC=0

# FreeLLM router (self-hosted free-tier aggregator — docs/FREELLM.md)
FREELLM_API_KEY=
FREELLM_BASE_URL=
FREELLM_MODEL=

# Composio hosted MCP (docs/MCP.md — needs Classic's account; free tier)
COMPOSIO_MCP_URL=
COMPOSIO_API_KEY=

# --- PRIVATE LANE + PRIVATE CALL (local-only; docs/PRIVATE_LANE.md) ---
# Both are SERVER-SIDE ONLY on purpose — they name the privacy boundary, so
# they never get a NEXT_PUBLIC_ twin baked into a client bundle. Each must be a
# NUMERIC loopback literal (127.x or ::1); host names, "localhost" included,
# are refused and the lane declines to start (src/lib/private/loopback.ts).
# Both have these exact values as their in-code default, so leaving them blank
# is safe — set them only if you moved a port.
# PRIVATE_GPT_BASE: private-gpt (brain). Port must match PRIVATE_GPT_PORT in
#   scripts/private-gpt-up.sh (default 8080).
# WHISPER_BASE: whisper.cpp (ears, PRIVATE CALL only). scripts/whisper-up.sh
#   hardcodes 127.0.0.1:8178 with no override.
PRIVATE_GPT_BASE=http://127.0.0.1:8080/v1
WHISPER_BASE=http://127.0.0.1:8178

# Her LOCAL (Piper) voice. Default in code = en_GB-cori-medium — same Cori as
# -high, faster tier (RTF 0.39 vs 3.14 on an Intel Mac). Set this only to
# override; fetch a tier first with:
#   bash scripts/bootstrap-piper-assets.sh en_GB-cori-high
NEXT_PUBLIC_STARRA_LOCAL_VOICE=

# --- ONE BRAIN (docs/ONE_BRAIN.md) — see CLAUDE.md Stack for the standing order ---
# Monthly xAI spend ceiling in USD. At the ceiling she STAYS on grok-4.5 and
# SAYS SO to Classic — she is never silently swapped to another brain for cost.
# Works alongside existing XAI_API_KEY / XAI_MODEL. Default: 40.
STARRA_MONTHLY_CEILING_USD=
# Set to 1 to force the free Groq lane (see existing GROQ_API_KEY / GROQ_MODEL
# / LLM_PROVIDER) as an emergency fallback. Always announced — to Classic and
# to her — never a silent switch. Default: unset (0/off).
STARRA_EMERGENCY_LANE=
# Set to 1 to stream completed sentences into the live call so first audio
# tracks time-to-first-token instead of waiting on the whole reply. GATED:
# default OFF, and stays off until Classic has heard it work on a live call.
NEXT_PUBLIC_STARRA_CALL_STREAM_SENTENCES=

# MCP memory bridge — long random value. The bridge FAILS CLOSED without it.
# Generate: openssl rand -hex 32
STARRA_MCP_TOKEN=
