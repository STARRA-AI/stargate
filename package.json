{
  "name": "stargate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "pack": "repomix --config repomix.config.json",
    "tools:bootstrap": "bash scripts/bootstrap-tools.sh",
    "tools:bootstrap-multica": "bash scripts/bootstrap-multica.sh",
    "tools:bootstrap-openalice": "bash scripts/bootstrap-openalice.sh",
    "tools:bootstrap-obsidian-skills": "bash scripts/bootstrap-obsidian-skills.sh",
    "tools:bootstrap-plinius": "bash scripts/bootstrap-plinius-corpus.sh",
    "tools:distill": "node scripts/distill-prompt-patterns.mjs",
    "tools:montage-status": "node -e \"const fs=require('fs');const p='vendor/OpenMontage/README.md';console.log(fs.existsSync(p)?'OpenMontage: present':'OpenMontage: missing — npm run tools:bootstrap')\"",
    "tools:montage-setup": "bash scripts/montage-setup.sh",
    "vault:init": "bash scripts/vault-init.sh",
    "vault:sync": "bash scripts/vault-sync.sh",
    "starra": "bash scripts/starra",
    "starra:up": "bash scripts/starra open",
    "starra:stop": "bash scripts/starra stop",
    "starra:status": "bash scripts/starra status",
    "starra:install": "bash scripts/starra install",
    "voice:download": "python3 scripts/download_voice.py",
    "setup:mac": "bash scripts/setup_mac.sh",
    "test:v2": "npx --yes tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "next": "15.5.20",
    "onnxruntime-web": "^1.27.0",
    "pdf-parse": "^2.4.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "repomix": "^1.16.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
