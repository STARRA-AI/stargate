# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
/data/*.json
!/data/.gitkeep
/data/packs/
/data/uploads/
/data/openmontage-briefs/

# Vendor clones (bootstrap with npm run tools:bootstrap)
/vendor/OpenMontage/
/vendor/multica/
/vendor/openalice/
/vendor/private-gpt/
/vendor/whisper.cpp/
/docs/reference/system_prompts_leaks/

# Repomix default dumps
repomix-output.*


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# operator secrets & local state
/data/keys.json
.env.local
.env*.local
/docs/*.png

# runtime state & heavy vendor
/data/
/vendor/

# Piper voice models (download with scripts/bootstrap-piper-assets.sh)
/public/brand/voice/*.onnx
/public/brand/voice/*.onnx.json
# Her local mouth's WASM runtime — the piper phonemizer + espeak-ng data + the
# onnxruntime binaries, fetched/copied by the same script (~46MB). Binaries, not
# source: they belong on disk next to the models, never in the history.
/public/brand/voice/wasm/

# Local tooling
.tools/

# Compiled native-app binaries (build artifacts — keep desktop/main.swift source only)
desktop/STARGATE
desktop/*.bak
desktop/build/

# MediaPipe face detector — wasm + model (provision with npm run face:download)
/public/vendor/mediapipe/
certs/

# Playwright MCP runtime profile (browser state — never committed)
/.playwright-mcp/

# Starra call service: cached copy of her canon (source of truth is src/lib/persona.ts)
.env.local.bak.*
vendor/

# starra-loop division reports — run scratch, not source
.agents/
# per-machine Claude Code permissions, not shared config
.claude/settings.local.json

# Playwright
/e2e/.auth/
/test-results/
/playwright-report/
