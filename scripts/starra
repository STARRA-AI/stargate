#!/usr/bin/env bash
# One-word launcher for STARRA / STARGATE.
# Usage:
#   starra          # up + open browser
#   starra up       # start Ollama + deck in background
#   starra open     # open HUD
#   starra stop     # stop deck (Ollama stays)
#   starra status   # health
#   starra install  # put `starra` on PATH + double-clickable .command
set -euo pipefail

# Resolve this script's REAL path before deriving PROJ. `starra install` drops a
# SYMLINK at ~/bin/starra → scripts/starra (verified: ls -l ~/bin/starra), and
# `dirname "$0"` on that symlink yields ~/bin, so PROJ became $HOME — sending the
# pid file, the logs and the pre-`npm run dev` `cd` to the wrong directory.
# That bug already fired: /Users/work/data/starra-dev.pid was written 2026-07-25
# 23:39, one minute after the symlink was created. Split-brain state like that is
# exactly how `status` ends up lying and the deck ends up silently down.
# Follow the symlink chain to the real file instead (bounded, so a link loop
# can't hang the launcher).
_src="${BASH_SOURCE[0]}"
_hops=0
while [[ -L "$_src" && $_hops -lt 20 ]]; do
  _t="$(readlink "$_src")"
  if [[ "$_t" == /* ]]; then _src="$_t"; else _src="$(dirname "$_src")/$_t"; fi
  _hops=$((_hops + 1))
done
PROJ="$(cd "$(dirname "$_src")/.." && pwd)"
unset _src _hops
STORAGE="/Volumes/Storage"
MODELS="$STORAGE/STARRA/ollama/models"
LOG_DIR="${STORAGE}/STARRA/logs"
# MOUNTED IS NOT WRITABLE. Under launchd, macOS TCC denies removable volumes,
# so `-d` passed on a mounted Storage and every write still died with
# "Operation not permitted" — which silently killed EVERY watchdog revival
# (found 2026-08-08: the deck stayed down 100s while the guard retried twice).
# A real shell has the permission and a LaunchAgent does not, so existence can
# never stand in for access. Probe with an actual write; fall back into the
# repo, which the keepalive installer already proves launchd can read.
if ! { mkdir -p "$LOG_DIR" 2>/dev/null && touch "$LOG_DIR/.starra-write-test" 2>/dev/null; }; then
  LOG_DIR="$PROJ/data/logs"
fi
rm -f "${LOG_DIR}/.starra-write-test" 2>/dev/null || true
mkdir -p "$LOG_DIR" "$PROJ/data" 2>/dev/null || true

PID_FILE="$PROJ/data/starra-dev.pid"
LOG="$LOG_DIR/starra-up.log"
PORT="${STARRA_PORT:-3000}"
# Sentinel telling the launchd watchdog "Classic stopped her on purpose — stay
# down". Without it, `starra stop` would race the watchdog and she'd pop right
# back up. `starra up` clears it. See scripts/starra-watchdog.sh.
PAUSE_FILE="$PROJ/data/starra-paused"
# launchd job label — kept in one place so the script, the plist and the
# installer can never drift apart.
KEEPALIVE_LABEL="com.starra.deck"
# The watchdog this launcher supervises with, and the pid file it writes so a
# `starra status` typed in any fresh shell can see whether she is really guarded.
WATCHDOG="$PROJ/scripts/starra-watchdog.sh"
GUARD_PID_FILE="$PROJ/data/starra-watchdog.pid"

# ── TLS ── Serve HTTPS when a locally-trusted mkcert cert is present, so browsers
# stop warning "Not secure" and the mic/camera work over the LAN (secure context
# is required for getUserMedia off localhost). Falls back to plain HTTP when no
# cert exists. Trust the CA once: `mkcert -install` on the Mac + install
# rootCA.pem on the iPhone (see: mkcert -CAROOT).
CERT="$PROJ/certs/deck-cert.pem"
KEY="$PROJ/certs/deck-key.pem"
# HTTPS AUTO-UPGRADE (2026-07-29). Previously HTTPS was purely opt-in via
# STARRA_HTTPS=1, and the default was plain HTTP — which meant the deck answered on
# the Wi-Fi in cleartext (verified: http://192.168.1.65:3000/login returned 200 from
# the LAN), carrying the login password and the session cookie unencrypted.
#
# It now upgrades ITSELF the moment TLS can be served without friction, i.e. when
# BOTH are true:
#   - the mkcert leaf exists (certs/deck-cert.pem, valid to Oct 2028, SANs cover
#     localhost + 127.0.0.1 + 192.168.1.65 + ::1), and
#   - the mkcert ROOT CA is actually trusted in a keychain, so browsers show no
#     warning. Checked, never assumed — an untrusted CA would hand Classic a scary
#     interstitial, which is why plain HTTP was the safe default before.
#
# So: run `mkcert -install` once (it needs the Mac password, which is why this
# cannot self-serve) and every later launch is HTTPS automatically. The deck's
# auth cookie also picks up its `secure` flag on its own at that point
# (src/app/api/auth/route.ts, isSecureRequest).
#
# Overrides, both honored: STARRA_HTTPS=1 forces TLS even if the CA is untrusted;
# STARRA_HTTPS=0 forces plain HTTP even if it is trusted.
mkcert_ca_trusted() {
  command -v security >/dev/null 2>&1 || return 1
  security find-certificate -a -c "mkcert" /Library/Keychains/System.keychain 2>/dev/null \
    | grep -q "labl" && return 0
  security find-certificate -a -c "mkcert" "$HOME/Library/Keychains/login.keychain-db" 2>/dev/null \
    | grep -q "labl" && return 0
  return 1
}
STARRA_HTTPS_EFFECTIVE="${STARRA_HTTPS:-auto}"
if [[ "$STARRA_HTTPS_EFFECTIVE" == "auto" ]]; then
  if [[ -f "$CERT" && -f "$KEY" ]] && mkcert_ca_trusted; then
    STARRA_HTTPS_EFFECTIVE=1
  else
    STARRA_HTTPS_EFFECTIVE=0
  fi
fi
if [[ "$STARRA_HTTPS_EFFECTIVE" == "1" && -f "$CERT" && -f "$KEY" ]]; then
  SCHEME="https"
# ── BIND DUAL-STACK (2026-08-08) ── `::` accepts BOTH IPv6 and IPv4 on macOS
# (IPV6_V6ONLY defaults off), where 0.0.0.0 accepted IPv4 only.
#
# This is not cosmetic: TOUCH ID DEPENDS ON IT. WebAuthn refuses to bind a
# passkey to an IP address (src/lib/webauthn.ts:72-74), so passkeys only work at
# https://localhost:3000 — a NAME, not 127.0.0.1. But `localhost` resolves to
# ::1 first on this Mac (`dscacheutil -q host -a name localhost` returns both),
# and against an IPv4-only bind that connection was refused. Dual-stack is what
# makes the localhost URL — and therefore Touch ID — actually reachable.
#
# Verified 2026-08-08, all four answer 200: 127.0.0.1, localhost, [::1], and the
# LAN address 192.168.1.222 (so the phone is unaffected).
  HOST="${STARRA_HOST:-::}"   # all interfaces, both families — phone + Touch ID
else
  SCHEME="http"
  # Default to all interfaces, both families, for the same reasons as above.
  # Override with STARRA_HOST=127.0.0.1 to force loopback-only.
  HOST="${STARRA_HOST:-::}"
fi
# localhost, NOT 127.0.0.1 — this is the URL Classic actually clicks, and Touch
# ID only works on a NAME (WebAuthn forbids an IP as the passkey rpID; see
# src/lib/webauthn.ts:72-74). Both resolve to the same deck now that the bind is
# dual-stack, so pointing at the name costs nothing and is the difference
# between Touch ID being offered and being refused.
URL="${SCHEME}://localhost:${PORT}"

# Is the deck's auth gate actually armed? src/middleware.ts:16-17 reads:
#   "Gate is OFF until a password is configured — never lock the deck with no key."
#   if (!authPassword()) return NextResponse.next();
# and src/lib/auth.ts:18 sources that from process.env.STARRA_PASSWORD. So the
# gate exists ONLY when STARRA_PASSWORD is non-empty. Checked without ever
# printing the value.
deck_password_set() {
  [[ -n "${STARRA_PASSWORD:-}" ]] && return 0
  local v
  v="$(grep -m1 '^STARRA_PASSWORD=' "$PROJ/.env.local" 2>/dev/null | cut -d= -f2- || true)"
  v="${v%$'\r'}"
  v="${v%\"}"; v="${v#\"}"
  v="${v%\'}"; v="${v#\'}"
  [[ -n "$v" ]]
}

# ── LAN EXPOSURE GUARD ── 0.0.0.0 publishes the deck to every device on the
# Wi‑Fi. That is only acceptable while the auth gate above is armed; with no
# password the middleware waves everyone through, so binding wide would put an
# UNLOCKED STARRA on the network. Fail closed to loopback instead, and say so.
# This is what makes the LAN default safe by construction rather than by comment.
LAN_GUARD=""
if [[ "$HOST" == "0.0.0.0" ]] && ! deck_password_set; then
  HOST="127.0.0.1"
  LAN_GUARD="no-password"
fi

ollama_up() {
  curl -sf --max-time 2 "http://127.0.0.1:11434/api/tags" >/dev/null 2>&1
}

deck_up() {
  # -k: accept the cert even before the CA is trusted, so the health check works.
  curl -sfk --max-time 2 "${SCHEME}://127.0.0.1:${PORT}/" >/dev/null 2>&1
}

# Authoritative bind check for `status`: asks the OS what the listening
# socket is actually bound to (lsof shows "*:PORT" for 0.0.0.0, "127.0.0.1:
# PORT" for loopback-only) rather than trusting this invocation's $HOST —
# which can be stale if STARRA_HOST wasn't exported in *this* shell even
# though the running deck was started elsewhere with a different value.
# Scans EVERY listening socket on the port, not just the first line: a host can
# hold both a wildcard and a loopback listener (or v4 + v6), and `head -1` would
# pick whichever lsof happened to print first and could answer backwards.
# "*:PORT" / "0.0.0.0:PORT" / "[::]:PORT" all mean all-interfaces.
deck_bound_all_interfaces() {
  lsof -nP -iTCP:"${PORT}" -sTCP:LISTEN 2>/dev/null | awk 'NR>1{print $9}' \
    | grep -qE '^\*:|^0\.0\.0\.0:|^\[::\]:'
}

# This Mac's LAN address, derived live. Does NOT hardcode en0: en0 is Wi‑Fi on
# this machine today (route -n get default → "interface: en0", verified), but on
# Ethernet or a dock the primary interface is a different device and a hardcoded
# en0 would print a stale or empty address. Ask the routing table first, then
# fall back. Prints nothing when there is no LAN address at all.
lan_ip() {
  local iface ip i
  iface="$(route -n get default 2>/dev/null | awk -F'interface:' '/interface:/{gsub(/ /,"",$2); print $2; exit}')"
  for i in "$iface" en0 en1; do
    [[ -n "$i" ]] || continue
    ip="$(ipconfig getifaddr "$i" 2>/dev/null || true)"
    if [[ -n "$ip" ]]; then echo "$ip"; return 0; fi
  done
  return 0
}

# SINGLE SOURCE OF TRUTH for the phone line — every caller (up / open / status)
# goes through here, so there is exactly one place that can ever print a phone
# URL and it always asks the OS first. A URL is emitted ONLY when the kernel
# confirms a wildcard bind AND this Mac actually has a LAN address; otherwise it
# prints why not. Never trusts $HOST, because a `starra status` typed in a fresh
# shell has no idea what STARRA_HOST the running deck was launched with.
#   $1 = "probe" → also curl the LAN URL and report real reachability.
phone_link_line() {
  if [[ "${LAN_GUARD:-}" == "no-password" ]]; then
    echo "  phone link: OFF — STARRA_PASSWORD is unset, so the auth gate is off"
    echo "               (src/middleware.ts:16-17) and the LAN bind is refused."
    echo "               Set STARRA_PASSWORD in .env.local, then: starra up"
    return 0
  fi
  if ! deck_bound_all_interfaces; then
    echo "  phone link: not on the LAN — bound to loopback only."
    echo "               Run: STARRA_HOST=0.0.0.0 starra up"
    return 0
  fi
  local lan url
  lan="$(lan_ip)"
  if [[ -z "$lan" ]]; then
    echo "  phone link: unavailable — this Mac has no LAN address right now"
    return 0
  fi
  url="${SCHEME}://${lan}:${PORT}"
  if [[ "${1:-}" == "probe" ]]; then
    # Curling the LAN IP from this Mac proves the socket answers on the LAN
    # address itself (not just loopback). It cannot prove the iPhone's Wi‑Fi
    # path or a firewall in between — so it is reported as "answering", not as
    # a promise about the phone.
    if curl -sfk --max-time 2 "${url}/" >/dev/null 2>&1; then
      echo "● Phone (same Wi‑Fi): ${url} (answering on the LAN address)"
    else
      echo "○ Phone (same Wi‑Fi): ${url} (bound to the LAN but not answering)"
    fi
  else
    echo "  Phone (same Wi‑Fi): ${url}"
  fi
  public_link "${1:-}"
}

# The public link is a cloudflared QUICK tunnel, so its hostname is random and
# CHANGES on every cloudflared restart — reboot, crash, KeepAlive respawn. That
# is by design and no amount of uptime fixes it: a link saved yesterday can be
# dead today while the deck is perfectly healthy. So never print it from memory
# — read the one the RUNNING tunnel actually registered, newest last.
public_link() {
  local log="$PROJ/data/tunnel.log" u
  [[ -f "$log" ]] || return 0
  u="$(grep -ohE 'https://[a-z0-9-]+\.trycloudflare\.com' "$log" 2>/dev/null | tail -1)"
  [[ -n "$u" ]] || return 0
  if [[ "${1:-}" == "probe" ]]; then
    if curl -sf --max-time 12 -o /dev/null "${u}/login" 2>/dev/null; then
      echo "● Public link: ${u} (answering)"
    else
      echo "○ Public link: ${u} (not answering — tunnel may have rotated it)"
    fi
  else
    echo "  Public link: ${u}"
  fi
}

# Guard against the dead-symlink trap: if ~/.ollama/models is a symlink whose
# target is gone (e.g. Storage reformatted/unmounted), Ollama's MkdirAll follows
# the link, gets ENOENT, then mkdir()s the link itself → "mkdir …: file exists".
# Removing a *dangling* link loses no data (the target is already gone).
heal_default_models() {
  local d="$HOME/.ollama/models"
  if [[ -L "$d" && ! -e "$d" ]]; then
    echo "⚠ ~/.ollama/models is a dangling symlink → $(readlink "$d")"
    echo "  Healing: replacing dead link with a real directory (no models lost — target was gone)."
    rm -f "$d" && mkdir -p "$d" && echo "● ~/.ollama/models is now a real directory"
  fi
}

# ── ENGINE ROOM ── the stocks/crypto paper engine, on loopback 47401.
# The deck's /api/stocks reads it and degrades to { linked: false } when it is
# down, so a missing engine is never fatal — it just means the ENGINE ROOM panel
# sits dark. Starting it here is what makes the panel real after a reboot
# instead of a manual step Classic has to remember.
ENGINE_DIR="$HOME/STARGATE/engine"
ENGINE_PORT=47401

engine_up() { curl -s -m 2 -o /dev/null "http://127.0.0.1:${ENGINE_PORT}/health"; }

start_engine() {
  if engine_up; then
    echo "● Engine Room already online"
    return 0
  fi
  if [[ ! -x "$ENGINE_DIR/.venv/bin/python" ]]; then
    echo "◆ Engine Room venv missing at $ENGINE_DIR/.venv — skipping (deck runs fine without it)."
    return 0
  fi
  echo "→ Starting Engine Room on 127.0.0.1:${ENGINE_PORT}…"
  # Same trap-HUP form the deck and Ollama use: macOS nohup dies under launchd.
  ( cd "$ENGINE_DIR" && trap '' HUP && exec .venv/bin/python -m uvicorn engine_room.api:app \
      --host 127.0.0.1 --port "$ENGINE_PORT" ) </dev/null >>"$LOG" 2>&1 &
  for _ in {1..25}; do
    engine_up && { echo "● Engine Room online (paper)"; return 0; }
    sleep 1
  done
  echo "⚠ Engine Room did not answer on ${ENGINE_PORT} — deck continues, panel stays unlinked."
  return 0
}

stop_engine() {
  if pgrep -f "uvicorn engine_room.api:app" >/dev/null 2>&1; then
    pkill -f "uvicorn engine_room.api:app" >/dev/null 2>&1 || true
    echo "● Engine Room stopped"
  fi
}

start_ollama() {
  if ollama_up; then
    echo "● Ollama already online"
    return 0
  fi
  if [[ -d "$MODELS" ]]; then
    export OLLAMA_MODELS="$MODELS"
    echo "→ Ollama models: $OLLAMA_MODELS"
  else
    heal_default_models
    echo "→ Ollama models: default (Storage not mounted)"
  fi
  export OLLAMA_HOST="127.0.0.1:11434"
  # Speed pack (P2 Task 1, 2026-08-04): keep the active model resident so the
  # PRIVATE LANE's first ask after any idle gap doesn't pay a full cold model
  # load (Ollama's own default OLLAMA_KEEP_ALIVE is "5m" — verified via
  # `ollama serve --help`). -1 = never unload. Undo: `export
  # OLLAMA_KEEP_ALIVE=5m` (or unset it) before `starra up`, or edit this line.
  export OLLAMA_KEEP_ALIVE="${OLLAMA_KEEP_ALIVE:--1}"
  local bin="/usr/local/bin/ollama"
  [[ -x "$bin" ]] || bin="$(command -v ollama || true)"
  if [[ -z "$bin" ]]; then
    echo "◆ Ollama not found. Install from https://ollama.com then retry."
    return 1
  fi
  echo "→ Starting Ollama…"
  # Not nohup: macOS nohup aborts with "can't detach from console" when there is
  # no controlling terminal — exactly the launchd context the watchdog revives
  # from (it burned 47 revivals on 2026-08-02). Ignoring HUP + exec is the same
  # detachment and works with or without a terminal.
  # cd "$HOME" before exec: Ollama inherits this shell's cwd (the repo, under
  # TCC-shielded ~/Desktop) and passes it to every llama-server runner it
  # spawns; in a launchd-context revival the runner's getcwd() then returns
  # EPERM and the runner dies at birth — every model load 500s (measured
  # 2026-08-05, "call to getcwd failed: Operation not permitted" during the
  # call feature outage). $HOME is never TCC-shielded; models path is already
  # absolute via OLLAMA_MODELS, so nothing else reads the cwd.
  ( trap '' HUP; cd "$HOME"; exec "$bin" serve ) </dev/null >>"$LOG" 2>&1 &
  for _ in $(seq 1 20); do
    ollama_up && { echo "● Ollama online"; return 0; }
    sleep 0.5
  done
  echo "◆ Ollama did not come up. Check $LOG"
  return 1
}

# Make npm/node reachable even when launched from STARRA.app or Spotlight, where
# the GUI PATH is minimal and nvm (which owns npm) is never sourced — otherwise
# `npm run dev` dies with "npm: No such file or directory". Mirrors
# start_ollama: resolve the toolchain instead of trusting the inherited PATH.
# Prepends the node bin dir so npm AND its child node/next processes resolve.
ensure_node_on_path() {
  command -v npm >/dev/null 2>&1 && return 0
  if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    export NVM_DIR="$HOME/.nvm"
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
  fi
  if ! command -v npm >/dev/null 2>&1; then
    local nb
    nb="$(ls -dt "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | head -1)"
    [[ -n "$nb" ]] && export PATH="$nb:$PATH"
  fi
  for d in /opt/homebrew/bin /usr/local/bin; do
    command -v npm >/dev/null 2>&1 && break
    [[ -x "$d/npm" ]] && export PATH="$d:$PATH"
  done
  command -v npm >/dev/null 2>&1
}

start_deck() {
  if deck_up; then
    echo "● Deck already online at $URL"
    return 0
  fi
  if [[ -f "$PID_FILE" ]]; then
    local old
    old="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$old" ]] && kill -0 "$old" 2>/dev/null; then
      echo "→ Waiting for deck pid ${old}…"
      for _ in $(seq 1 40); do
        deck_up && { echo "● Deck online"; return 0; }
        sleep 0.5
      done
      echo "◆ Deck pid ${old} is running but never answered; treating as stuck."
    elif [[ -n "$old" ]]; then
      echo "◆ Stale pid file: process ${old} is not running (likely a reboot). Cleaning up."
    else
      echo "◆ Empty pid file found. Cleaning up."
    fi
    rm -f "$PID_FILE"
  fi
  if ! ensure_node_on_path; then
    echo "◆ npm not found. Install Node (nvm or Homebrew) then retry."
    return 1
  fi
  if [[ "${LAN_GUARD:-}" == "no-password" ]]; then
    echo "◆ LAN bind refused: STARRA_PASSWORD is not set, so the deck's auth gate"
    echo "  is off (src/middleware.ts:16-17) and 0.0.0.0 would publish an unlocked"
    echo "  STARRA to the Wi‑Fi. Binding loopback only. Set STARRA_PASSWORD in"
    echo "  .env.local to turn the phone link back on."
  fi
  echo "→ Starting STARGATE (${SCHEME}) on ${HOST}:${PORT}…"
  cd "$PROJ"
  # --hostname $HOST (0.0.0.0 under HTTPS) so the iPhone on the same Wi‑Fi can reach the Mac.
  # Same trap-HUP form as start_ollama (macOS nohup dies under launchd — see there).
  # ★ THE PRODUCTION LANE IS THE DEFAULT (2026-09-22).
  #
  # MEASURED on the login page — the LIGHTEST page in the app, no canvas, no
  # video, no avatar — same browser, minutes apart:
  #
  #                        dev lane      prod lane
  #   JavaScript shipped    659 KB        122 KB     5.4x less
  #   JS requests              20             9
  #   DOMContentLoaded      673 ms        131 ms     5.1x faster
  #   load event           4426 ms       2074 ms     2.1x faster
  #   JS heap                 9 MB          3 MB     3x less
  #
  # Dev mode also runs React with development-mode checks on EVERY render. Her
  # viseme canvas composites at ~30fps, the reactor rides the analyser bus and
  # the HUD animates — every one of those frames paid that tax, on every surface,
  # forever. This is the one change that reaches the whole app rather than one
  # lane of it.
  #
  # THE TRADE, stated plainly: a code change now needs a rebuild instead of hot
  # reload. `STARRA_LANE=dev scripts/starra up` puts HMR back, unchanged.
  #
  # HTTPS ONLY. scripts/deck-server.mjs is HTTPS-only by design (a prod deck on
  # http breaks Touch ID and the phone link), so an http start — which only
  # happens when the mkcert pair is missing — stays on dev rather than failing.
  LANE="${STARRA_LANE:-prod}"
  if [[ "$LANE" == "prod" && "$SCHEME" != "https" ]]; then
    echo "◆ No mkcert pair, so the production lane cannot serve https. Using dev."
    LANE="dev"
  fi

  if [[ "$LANE" == "prod" ]]; then
    # Rebuild only when something under src/ or public/ is newer than the build.
    # STARRA_DIST keeps this out of .next, so a build never clobbers a running
    # dev server (that lesson cost a 500ing deck once already).
    local DIST="${STARRA_DIST:-.next-prod}"
    if [[ ! -f "$DIST/BUILD_ID" ]] || [[ -n "$(find src public -newer "$DIST/BUILD_ID" -print -quit 2>/dev/null)" ]]; then
      echo "→ Building the production deck (first run, or sources changed)…"
      if ! STARRA_DIST="$DIST" npm run build >>"$LOG" 2>&1; then
        echo "◆ Production build FAILED — see $LOG. Falling back to the dev lane."
        LANE="dev"
      fi
    else
      echo "→ Production build is current — serving it."
    fi
  fi

  if [[ "$LANE" == "prod" ]]; then
    ( trap '' HUP; STARRA_DIST="${STARRA_DIST:-.next-prod}" STARRA_PORT="$PORT" \
      exec node scripts/deck-server.mjs ) </dev/null >>"$LOG" 2>&1 &
  elif [[ "$SCHEME" == "https" ]]; then
    # Next 15 dev TLS using our mkcert cert (trusted → no "Not secure" warning).
    ( trap '' HUP; exec npm run dev -- --experimental-https --experimental-https-key "$KEY" \
      --experimental-https-cert "$CERT" --hostname "$HOST" --port "$PORT" ) </dev/null >>"$LOG" 2>&1 &
  else
    ( trap '' HUP; exec npm run dev -- --hostname "$HOST" --port "$PORT" ) </dev/null >>"$LOG" 2>&1 &
  fi
  echo $! >"$PID_FILE"
  for _ in $(seq 1 60); do
    if deck_up; then
      echo "● Deck online at $URL"
      # `probe`, not a bare print: `starra up` must never hand him a phone URL it
      # has not just curled. The deck is answering by definition here, so the
      # extra check costs one local request.
      phone_link_line probe
      return 0
    fi
    sleep 0.5
  done
  echo "◆ Deck did not come up. Check $LOG"
  return 1
}

cmd_up() {
  # Bringing her up cancels any deliberate stop, so the watchdog resumes guarding.
  rm -f "$PAUSE_FILE" 2>/dev/null || true
  # Don't abort the whole launcher if one step returns non-zero.
  set +e
  start_ollama
  local o=$?
  start_engine
  start_deck
  local d=$?
  set -e
  if [[ $o -ne 0 ]]; then
    echo "⚠ Ollama step had trouble. You can still try the deck."
  fi
  if [[ $d -ne 0 ]]; then
    echo "◆ Deck failed to start. Last log lines:"
    tail -20 "$LOG" 2>/dev/null || true
    return 1
  fi
  # Arm the crash guard from THIS shell — see start_guard for why launchd cannot
  # do it while the repo lives under ~/Desktop. Silent when something else is
  # already guarding her; never claims a guard it did not confirm alive.
  set +e
  if [[ -z "${STARRA_WATCHDOG:-}" ]] && ! guard_pid >/dev/null 2>&1 && [[ "$(keepalive_state)" != "running" ]]; then
    if start_guard; then
      echo "● Crash guard on (watchdog pid $(guard_pid)) — she comes back on her own if the deck dies."
    else
      echo "○ Crash guard could not start — she is up, but will not revive herself."
      echo "  Detail: $LOG_DIR/starra-keepalive.log"
    fi
  fi
  set -e
  return 0
}

cmd_open() {
  if ! deck_up; then
    echo "→ Deck is offline. Starting STARRA…"
    set +e
    cmd_up
    set -e
  fi
  if deck_up; then
    open "$URL" 2>/dev/null || true
    echo ""
    echo "Copy. STARRA is up."
    echo "  On this Mac:  $URL"
    phone_link_line
    echo "  Wake: say \"starra\" or press Option+Space"
    echo ""
  else
    echo ""
    echo "◆ Still offline. Use this safer command instead:"
    echo "  cd $PROJ"
    echo "  npm run starra"
    echo ""
    return 1
  fi
}
# Kill whatever is holding the deck port, whichever lane started it.
#
# BY PORT, NOT BY NAME. `pkill -f next-server` once killed his LIVE DECK, so the
# rule is kill by PID or by port and never by a generic process name. lsof gives
# the exact holder; the `next dev`/deck-server patterns are a narrow, port-scoped
# fallback for the case where lsof is unavailable.
stop_port_holder() {
  local holders
  holders="$(lsof -ti tcp:"${PORT}" 2>/dev/null || true)"
  if [[ -n "$holders" ]]; then
    echo "$holders" | while read -r h; do
      [[ -n "$h" ]] && kill "$h" 2>/dev/null || true
    done
    return 0
  fi
  pkill -f "next dev.*${PORT}" 2>/dev/null || true
  pkill -f "deck-server.mjs" 2>/dev/null || true
}


cmd_stop() {
  # Tell the watchdog this is intentional BEFORE killing anything — otherwise it
  # sees the health check fail and immediately brings her back, and `starra stop`
  # looks broken.
  mkdir -p "$(dirname "$PAUSE_FILE")" 2>/dev/null || true
  : >"$PAUSE_FILE"
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "→ Stopping deck pid ${pid}…"
      kill "$pid" 2>/dev/null || true
      # also kill the child server if present — EITHER LANE. The prod lane runs
      # `node scripts/deck-server.mjs`, which the `next dev` pattern never
      # matched, so before this a prod deck survived `starra stop` and kept
      # holding the port.
      stop_port_holder
    fi
    rm -f "$PID_FILE"
  else
    stop_port_holder
  fi
  echo "● Deck stopped (Ollama left running). Watchdog paused — \`starra up\` resumes it."
}

# macOS TCC shields a handful of user folders (Desktop/Documents/Downloads)
# from launchd-spawned jobs: the job can chdir in, but READING a file there
# returns EPERM. Measured on this Mac 2026-07-28 — a throwaway launchd agent
# doing `head -c 1 package.json` under ~/Desktop came back "Operation not
# permitted" — and it is why scripts/macos/install-keepalive.sh declines to
# install here (install-keepalive.sh:93-125).
# Status needs this so it never points Classic at an installer that will
# refuse: when the repo IS shielded, the one-time unblock has to be named
# first, because it is the only thing that makes the installer work.
repo_shielded() {
  case "$PROJ/" in
    "$HOME"/Desktop/*|"$HOME"/Documents/*|"$HOME"/Downloads/*) return 0 ;;
    *) return 1 ;;
  esac
}

# The honest "how do I get reboot coverage" answer for THIS machine, indented
# by the caller so it lines up under whichever status line raised the question.
# Never promises the installer alone is enough when it demonstrably is not.
keepalive_howto() {
  local pad="${1:-               }"
  if repo_shielded; then
    echo "${pad}Reboot coverage needs one one-time choice from you — macOS will not let"
    echo "${pad}launchd read this folder until then, so the installer declines:"
    echo "${pad}  a) System Settings → Privacy & Security → Full Disk Access → + → /bin/bash"
    echo "${pad}  b) or move this repo out of ~/Desktop (e.g. ~/Projects/stargate)"
    echo "${pad}then run: bash scripts/macos/install-keepalive.sh"
  else
    echo "${pad}Survive reboots too: bash scripts/macos/install-keepalive.sh"
  fi
}

# What launchd ACTUALLY thinks of the keepalive job:
#   absent      → not loaded at all
#   running     → has a live pid
#   failing:<n> → loaded but last run exited <n> (respawn loop)
# `launchctl list <label>` only prints a "PID" key while the job is alive, which
# is what lets us tell "protecting her" apart from "dying every 30 seconds".
keepalive_state() {
  local out st
  out="$(launchctl list "$KEEPALIVE_LABEL" 2>/dev/null)" || { echo "absent"; return 0; }
  [[ -z "$out" ]] && { echo "absent"; return 0; }
  if grep -q '"PID"' <<<"$out"; then echo "running"; return 0; fi
  st="$(awk -F'= ' '/"LastExitStatus"/{gsub(/[; ]/,"",$2); print $2; exit}' <<<"$out")"
  # launchd reports the raw wait status; >>8 turns 32256 into the real exit code 126.
  if [[ "$st" =~ ^[0-9]+$ ]] && (( st > 255 )); then st=$(( st >> 8 )); fi
  echo "failing:${st:-unknown}"
}

# ── CRASH GUARD (the keepalive that actually runs on this Mac) ───────────────
# Measured here 2026-07-28, not assumed:
#   • A launchd job is DENIED read access to anything under ~/Desktop —
#     `head -c 12 package.json` from a throwaway LaunchAgent returns "Operation
#     not permitted" — and it stays denied even when the script launchd runs
#     lives OUTSIDE ~/Desktop. It can still curl the deck; it can never read her
#     files to restart her. That is macOS TCC, and this repo is under ~/Desktop.
#   • A process started from a session that already HAS that access KEEPS it
#     after it is detached and reparented to launchd (probe: ppid=1, still
#     reading package.json every 2s long after its launcher exited).
# So the guard is spawned from HERE — from the shell Classic already typed in —
# instead of by launchd. That is the difference between a keepalive that works
# today with zero permission grants and one that dies every 30 seconds while
# claiming to protect her. The honest limit is stated in `status`: this covers
# crashes for as long as he stays logged in, not a reboot.
guard_pid() {
  local p
  [[ -f "$GUARD_PID_FILE" ]] || return 1
  p="$(cat "$GUARD_PID_FILE" 2>/dev/null || true)"
  [[ "$p" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$p" 2>/dev/null || return 1
  # Confirm the pid is really the watchdog. After a reboot that number belongs
  # to something else entirely, and trusting it would make `status` lie.
  ps -o command= -p "$p" 2>/dev/null | grep -q 'starra-watchdog' || return 1
  echo "$p"
  return 0
}

# Returns 0 only when a watchdog is confirmed ALIVE afterwards — never on the
# strength of having spawned one.
start_guard() {
  # We ARE the watchdog (it exports this): arming another would fork-bomb.
  if [[ -n "${STARRA_WATCHDOG:-}" ]]; then return 0; fi
  if guard_pid >/dev/null 2>&1; then return 0; fi
  # launchd is already doing the job (repo outside ~/Desktop, or FDA granted).
  if [[ "$(keepalive_state)" == "running" ]]; then return 0; fi
  if [[ ! -f "$WATCHDOG" ]]; then return 1; fi
  mkdir -p "$LOG_DIR" 2>/dev/null || true
  # HUP ignored so closing the Terminal window does not take her guard with it
  # (trap form, not nohup — macOS nohup dies under launchd, see start_ollama).
  ( trap '' HUP; exec bash "$WATCHDOG" ) </dev/null >>"$LOG_DIR/starra-keepalive.log" 2>&1 &
  disown "$!" 2>/dev/null || true
  local i
  for i in $(seq 1 12); do
    if guard_pid >/dev/null 2>&1; then return 0; fi
    sleep 0.3
  done
  return 1
}

# Stop means STOPPED. It must never return while the watchdog is still running,
# because it also deletes the pid file — and a live watchdog with no pid file is
# invisible to guard_pid, so the next `starra up` would arm a second one and two
# supervisors would race to restart the same deck. So: signal, WAIT for the
# process to actually be gone, escalate if it will not go, and only then clear
# the files.
stop_guard() {
  local p i
  if p="$(guard_pid)"; then
    kill "$p" 2>/dev/null || true
    for i in $(seq 1 20); do
      if ! kill -0 "$p" 2>/dev/null; then break; fi
      sleep 0.25
    done
    if kill -0 "$p" 2>/dev/null; then
      kill -9 "$p" 2>/dev/null || true
      for i in $(seq 1 12); do
        if ! kill -0 "$p" 2>/dev/null; then break; fi
        sleep 0.25
      done
    fi
    if kill -0 "$p" 2>/dev/null; then
      echo "◆ Watchdog pid $p will not die — leaving its pid file alone so status keeps telling the truth."
      return 1
    fi
  fi
  # Belt and braces for a watchdog that was SIGKILLed and never ran its trap.
  rm -f "$GUARD_PID_FILE" 2>/dev/null || true
  rm -rf "$PROJ/data/starra-watchdog.lock" 2>/dev/null || true
  return 0
}

cmd_guard() {
  case "${1:-}" in
    stop|off)
      stop_guard
      echo "● Crash guard off. She will not come back on her own until \`starra up\`."
      ;;
    ""|start|on)
      if [[ "$(keepalive_state)" == "running" ]]; then
        echo "● Already guarded by launchd (${KEEPALIVE_LABEL}) — nothing to do."
        return 0
      fi
      if start_guard; then
        echo "● Crash guard ON (watchdog pid $(guard_pid)) — she restarts herself if the deck dies."
      else
        echo "◆ Could not start the crash guard. Log: $LOG_DIR/starra-keepalive.log"
        return 1
      fi
      ;;
    *)
      echo "Usage: starra guard [stop]"
      return 1
      ;;
  esac
}

cmd_status() {
  if ollama_up; then echo "● Ollama"; else echo "○ Ollama"; fi

  # Local link: actually curl it, don't assume from the pid/bind config.
  if deck_up; then
    echo "● Deck $URL (reachable)"
  else
    echo "○ Deck $URL (unreachable)"
  fi

  # Phone link: one code path, and it probes for real. See phone_link_line.
  phone_link_line probe

  # Keepalive: registered with launchd is NOT the same as working. A job can be
  # loaded and still be dying on every launch (that is exactly what happened
  # here: macOS privacy blocked it, exit 126, and launchd kept respawning it).
  # So report launchd's ACTUAL state — running pid vs last exit status.
  # Two things can guard her and they are NOT the same promise, so they are
  # never reported as if they were: launchd survives a reboot; a session-armed
  # watchdog covers crashes until he logs out. Only the one that is really
  # running gets printed, and it is printed for what it actually covers.
  local kstate gpid
  kstate="$(keepalive_state)"
  gpid="$(guard_pid 2>/dev/null || true)"

  if [[ "$kstate" == "running" ]]; then
    if [[ -f "$PAUSE_FILE" ]]; then
      echo "● Keepalive: running, but PAUSED (you ran \`starra stop\`) — \`starra up\` resumes it"
    else
      echo "● Keepalive: armed (${KEEPALIVE_LABEL}) — she restarts on crash + at login"
    fi
  elif [[ -n "$gpid" ]]; then
    if [[ -f "$PAUSE_FILE" ]]; then
      echo "● Crash guard: ON (watchdog pid $gpid) but PAUSED (you ran \`starra stop\`) — \`starra up\` resumes it"
    else
      echo "● Crash guard: ON (watchdog pid $gpid) — she restarts herself within ~20s if the deck dies."
    fi
    echo "               Covers crashes while you stay logged in, but NOT a reboot —"
    echo "               after logging back in run \`starra\` once."
    keepalive_howto "               "
    # A shell guard being up must never HIDE a launchd agent that is loaded and
    # dying: that job respawns every 30s forever, burning CPU and filling the log
    # while looking like protection. Report it here or it is invisible.
    if [[ "$kstate" == failing:* ]]; then
      echo "◆              Note: a launchd keepalive (${KEEPALIVE_LABEL}) is ALSO loaded and FAILING"
      echo "               (last exit ${kstate#failing:}) — it respawns every 30s and can never work"
      echo "               from ~/Desktop. Clear it: launchctl bootout gui/$(id -u)/${KEEPALIVE_LABEL}"
    fi
  else
    case "$kstate" in
      failing:126|failing:1)
        echo "◆ Keepalive: LOADED BUT FAILING (exit 126 = macOS blocked it)."
        echo "               Cause: this repo is under ~/Desktop, which macOS shields from"
        echo "               background jobs — launchd can see the folder but not read the"
        echo "               files, so the watchdog dies instantly."
        echo "               Fix now (no permissions): starra guard"
        keepalive_howto "               "
        ;;
      failing:*)
        echo "◆ Keepalive: LOADED BUT FAILING (last exit ${kstate#failing:})."
        echo "               Log: $PROJ/data/logs/starra-keepalive.log"
        echo "               Guard her right now anyway: starra guard"
        ;;
      *)
        echo "○ Keepalive: not installed — she will NOT restart herself if she crashes."
        echo "               Arm it now, no permissions needed:  starra guard"
        keepalive_howto "               "
        ;;
    esac
  fi

  [[ -f "$LOG" ]] && echo "  log: $LOG"
  return 0
}

cmd_install() {
  local dest="${HOME}/bin"
  mkdir -p "$dest"
  ln -sf "$PROJ/scripts/starra" "$dest/starra"
  chmod +x "$PROJ/scripts/starra"

  if ! grep -q 'HOME/bin' "${HOME}/.zshrc" 2>/dev/null; then
    echo 'export PATH="$HOME/bin:$PATH"' >> "${HOME}/.zshrc"
    echo "● Added ~/bin to ~/.zshrc"
  fi

  echo "● CLI: $dest/starra"
  echo "→ Building STARRA.app with icon…"
  bash "$PROJ/scripts/macos/install-app.sh"

  echo ""
  echo "Launch her:"
  echo "  • Double-click STARRA in Applications (or Spotlight: STARRA)"
  echo "  • Or: npm run starra"
  echo "Wake (after the page opens): allow mic, say \"starra\" or Option+Space."
}

usage() {
  cat <<EOF
starra — wake STARGATE

  starra          up + open browser
  starra up       start Ollama + deck (background)
  starra open     open HUD (starts if needed)
  starra stop     stop deck
  starra status   health (deck + phone link + keepalive, all probed for real)
  starra guard    arm the crash guard now (starra up does this for you)
  starra guard stop   turn it off
  starra install  PATH + double-click STARRA.command

  Crash guard vs keepalive — they are not the same promise:
    starra guard                          crashes, while you are logged in. Works today.
    bash scripts/macos/install-keepalive.sh   crashes AND reboots — needs macOS to let
                                          launchd read this folder (it tells you how).
EOF
}

# lipsync <gradio-url> — point her lip-sync at a fresh Colab JoyVASA endpoint.
# Colab links are ephemeral (die when the session times out), so re-running the
# notebook prints a NEW url; this is the one-line way to refresh it + enable
# lip-sync + restart the deck so it takes effect. `starra lipsync off` disables.
cmd_lipsync() {
  local url="${1:-}"
  local env="$PROJ/.env.local"
  touch "$env"
  # strip any existing COLAB_LIPSYNC_URL / NEXT_PUBLIC_LIPSYNC lines
  grep -vE '^(COLAB_LIPSYNC_URL|NEXT_PUBLIC_LIPSYNC)=' "$env" > "$env.tmp" 2>/dev/null || true
  mv "$env.tmp" "$env"
  if [[ -z "$url" || "$url" == "off" ]]; then
    printf 'COLAB_LIPSYNC_URL=\nNEXT_PUBLIC_LIPSYNC=0\n' >> "$env"
    echo "lip-sync OFF (using her fluid clips)."
  else
    printf 'COLAB_LIPSYNC_URL=%s\nNEXT_PUBLIC_LIPSYNC=1\n' "$url" >> "$env"
    echo "lip-sync ON -> $url"
  fi
  echo "restarting the deck so it picks up the change…"
  cmd_stop >/dev/null 2>&1 || true
  cmd_up
}


# ── SIDE TOOLS ── NocoDB (business data + her memory as tables) and n8n
# (workflow automation). Deliberately OPT-IN, not part of `up`.
#
# WHY NOT AUTO-START: both are heavy, and on 2026-08-08 this Mac hit load 38 on
# 12 cores with everything running at once. The actual fault that day was a bad
# charging cable, not load — but adding two always-on services to a machine that
# already runs the deck, Ollama, whisper, private-gpt and the Engine Room is a
# choice Classic makes, not a default I impose.
#
#   scripts/starra tools up     scripts/starra tools stop     scripts/starra tools status
NOCO_DIR="$HOME/STARGATE/nocodb-data"
N8N_START="$HOME/STARGATE/n8n-data/start.sh"

cmd_tools() {
  case "${1:-status}" in
    up|start)
      if curl -s -m 2 -o /dev/null http://127.0.0.1:8090/dashboard/; then
        echo "● NocoDB already online"
      elif [[ -f "$NOCO_DIR/server.js" ]]; then
        ( cd "$NOCO_DIR" && trap '' HUP && NC_DISABLE_TELE=true exec node server.js ) </dev/null >>"$LOG" 2>&1 &
        echo "→ NocoDB starting  http://127.0.0.1:8090/dashboard/"
      else
        echo "◆ NocoDB not installed at $NOCO_DIR — skipping"
      fi
      if curl -s -m 2 -o /dev/null http://127.0.0.1:5678/; then
        echo "● n8n already online"
      elif [[ -x "$N8N_START" ]]; then
        ( trap '' HUP && exec "$N8N_START" ) </dev/null >>"$LOG" 2>&1 &
        echo "→ n8n starting     http://127.0.0.1:5678/"
      else
        echo "◆ n8n not installed at $N8N_START — skipping"
      fi
      ;;
    stop|down)
      pkill -f "nocodb-data/server.js" >/dev/null 2>&1 && echo "● NocoDB stopped" || echo "· NocoDB was not running"
      pkill -f "n8n" >/dev/null 2>&1 && echo "● n8n stopped" || echo "· n8n was not running"
      ;;
    status|st|"")
      curl -s -m 3 -o /dev/null http://127.0.0.1:8090/dashboard/ && echo "● NocoDB  http://127.0.0.1:8090/dashboard/" || echo "○ NocoDB  down"
      curl -s -m 3 -o /dev/null http://127.0.0.1:5678/ && echo "● n8n     http://127.0.0.1:5678/" || echo "○ n8n     down"
      ;;
    *) echo "Usage: starra tools [up|stop|status]"; return 1 ;;
  esac
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ""|open) cmd_open ;;
    up|start) cmd_up ;;
    stop|down) cmd_stop ;;
    status|st) cmd_status ;;
    guard|keepalive) shift; cmd_guard "${1:-}" ;;
    install) cmd_install ;;
    lipsync) shift; cmd_lipsync "${1:-}" ;;
    tools) shift; cmd_tools "${1:-}" ;;
    -h|--help|help) usage ;;
    *)
      echo "Unknown: $cmd"
      usage
      exit 1
      ;;
  esac
}

# Only run when EXECUTED, not when sourced. The watchdog and the test harness
# source this file to reuse deck_up/ollama_up/phone_link_line without launching
# anything — without this guard, sourcing it would fire cmd_open.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
