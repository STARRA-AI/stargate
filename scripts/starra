#!/usr/bin/env bash
# One-word launcher for STARRA / STARGATE.
# Usage:
#   starra          # up + open browser
#   starra up       # start Ollama + deck in background
#   starra open     # open HUD
#   starra stop     # stop deck (Ollama stays)
#   starra status   # health
#   starra install  # put `starra` on PATH + double-clickable .command
set -euo pipefail

PROJ="$(cd "$(dirname "$0")/.." && pwd)"
STORAGE="/Volumes/Storage"
MODELS="$STORAGE/STARRA/ollama/models"
LOG_DIR="${STORAGE}/STARRA/logs"
[[ -d "$STORAGE/STARRA" ]] || LOG_DIR="$PROJ/data/logs"
mkdir -p "$LOG_DIR" "$PROJ/data" 2>/dev/null || true

PID_FILE="$PROJ/data/starra-dev.pid"
LOG="$LOG_DIR/starra-up.log"
PORT="${STARRA_PORT:-3000}"

# ── TLS ── Serve HTTPS when a locally-trusted mkcert cert is present, so browsers
# stop warning "Not secure" and the mic/camera work over the LAN (secure context
# is required for getUserMedia off localhost). Falls back to plain HTTP when no
# cert exists. Trust the CA once: `mkcert -install` on the Mac + install
# rootCA.pem on the iPhone (see: mkcert -CAROOT).
CERT="$PROJ/certs/deck-cert.pem"
KEY="$PROJ/certs/deck-key.pem"
# HTTPS is OPT-IN: `STARRA_HTTPS=1 starra up` (with a cert present) serves TLS for
# the phone / secure-context. Default is plain HTTP so the deck ALWAYS loads with
# zero cert-trust friction. localhost HTTP is already a secure context, so the
# mic/camera still work on the Mac.
if [[ "${STARRA_HTTPS:-0}" == "1" && -f "$CERT" && -f "$KEY" ]]; then
  SCHEME="https"
  HOST="${STARRA_HOST:-0.0.0.0}"   # all interfaces so the phone can reach HTTPS
else
  SCHEME="http"
  HOST="${STARRA_HOST:-127.0.0.1}"
fi
URL="${SCHEME}://127.0.0.1:${PORT}"

ollama_up() {
  curl -sf --max-time 2 "http://127.0.0.1:11434/api/tags" >/dev/null 2>&1
}

deck_up() {
  # -k: accept the cert even before the CA is trusted, so the health check works.
  curl -sfk --max-time 2 "${SCHEME}://127.0.0.1:${PORT}/" >/dev/null 2>&1
}

# Guard against the dead-symlink trap: if ~/.ollama/models is a symlink whose
# target is gone (e.g. Storage reformatted/unmounted), Ollama's MkdirAll follows
# the link, gets ENOENT, then mkdir()s the link itself → "mkdir …: file exists".
# Removing a *dangling* link loses no data (the target is already gone).
heal_default_models() {
  local d="$HOME/.ollama/models"
  if [[ -L "$d" && ! -e "$d" ]]; then
    echo "⚠ ~/.ollama/models is a dangling symlink → $(readlink "$d")"
    echo "  Healing: replacing dead link with a real directory (no models lost — target was gone)."
    rm -f "$d" && mkdir -p "$d" && echo "● ~/.ollama/models is now a real directory"
  fi
}

start_ollama() {
  if ollama_up; then
    echo "● Ollama already online"
    return 0
  fi
  if [[ -d "$MODELS" ]]; then
    export OLLAMA_MODELS="$MODELS"
    echo "→ Ollama models: $OLLAMA_MODELS"
  else
    heal_default_models
    echo "→ Ollama models: default (Storage not mounted)"
  fi
  export OLLAMA_HOST="127.0.0.1:11434"
  local bin="/usr/local/bin/ollama"
  [[ -x "$bin" ]] || bin="$(command -v ollama || true)"
  if [[ -z "$bin" ]]; then
    echo "◆ Ollama not found. Install from https://ollama.com then retry."
    return 1
  fi
  echo "→ Starting Ollama…"
  nohup "$bin" serve >>"$LOG" 2>&1 &
  for _ in $(seq 1 20); do
    ollama_up && { echo "● Ollama online"; return 0; }
    sleep 0.5
  done
  echo "◆ Ollama did not come up. Check $LOG"
  return 1
}

# Make npm/node reachable even when launched from STARRA.app or Spotlight, where
# the GUI PATH is minimal and nvm (which owns npm) is never sourced — otherwise
# `nohup npm run dev` dies with "nohup: npm: No such file or directory". Mirrors
# start_ollama: resolve the toolchain instead of trusting the inherited PATH.
# Prepends the node bin dir so npm AND its child node/next processes resolve.
ensure_node_on_path() {
  command -v npm >/dev/null 2>&1 && return 0
  if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
    export NVM_DIR="$HOME/.nvm"
    # shellcheck disable=SC1090
    . "$NVM_DIR/nvm.sh" >/dev/null 2>&1 || true
  fi
  if ! command -v npm >/dev/null 2>&1; then
    local nb
    nb="$(ls -dt "$HOME"/.nvm/versions/node/*/bin 2>/dev/null | head -1)"
    [[ -n "$nb" ]] && export PATH="$nb:$PATH"
  fi
  for d in /opt/homebrew/bin /usr/local/bin; do
    command -v npm >/dev/null 2>&1 && break
    [[ -x "$d/npm" ]] && export PATH="$d:$PATH"
  done
  command -v npm >/dev/null 2>&1
}

start_deck() {
  if deck_up; then
    echo "● Deck already online at $URL"
    return 0
  fi
  if [[ -f "$PID_FILE" ]]; then
    local old
    old="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$old" ]] && kill -0 "$old" 2>/dev/null; then
      echo "→ Waiting for deck pid ${old}…"
      for _ in $(seq 1 40); do
        deck_up && { echo "● Deck online"; return 0; }
        sleep 0.5
      done
    fi
    rm -f "$PID_FILE"
  fi
  if ! ensure_node_on_path; then
    echo "◆ npm not found. Install Node (nvm or Homebrew) then retry."
    return 1
  fi
  echo "→ Starting STARGATE (${SCHEME}) on ${HOST}:${PORT}…"
  cd "$PROJ"
  # --hostname $HOST (0.0.0.0 under HTTPS) so the iPhone on the same Wi‑Fi can reach the Mac.
  if [[ "$SCHEME" == "https" ]]; then
    # Next 15 dev TLS using our mkcert cert (trusted → no "Not secure" warning).
    nohup npm run dev -- --experimental-https --experimental-https-key "$KEY" \
      --experimental-https-cert "$CERT" --hostname "$HOST" --port "$PORT" >>"$LOG" 2>&1 &
  else
    nohup npm run dev -- --hostname "$HOST" --port "$PORT" >>"$LOG" 2>&1 &
  fi
  echo $! >"$PID_FILE"
  for _ in $(seq 1 60); do
    if deck_up; then
      echo "● Deck online at $URL"
      echo "  Phone (same Wi‑Fi): ${SCHEME}://$(ipconfig getifaddr en0 2>/dev/null || echo YOUR_LAN_IP):${PORT}"
      return 0
    fi
    sleep 0.5
  done
  echo "◆ Deck did not come up. Check $LOG"
  return 1
}

cmd_up() {
  # Don't abort the whole launcher if one step returns non-zero.
  set +e
  start_ollama
  local o=$?
  start_deck
  local d=$?
  set -e
  if [[ $o -ne 0 ]]; then
    echo "⚠ Ollama step had trouble. You can still try the deck."
  fi
  if [[ $d -ne 0 ]]; then
    echo "◆ Deck failed to start. Last log lines:"
    tail -20 "$LOG" 2>/dev/null || true
    return 1
  fi
  return 0
}

cmd_open() {
  if ! deck_up; then
    echo "→ Deck is offline. Starting STARRA…"
    set +e
    cmd_up
    set -e
  fi
  if deck_up; then
    open "$URL" 2>/dev/null || true
    echo ""
    echo "Copy. STARRA is up."
    echo "  On this Mac:  $URL"
    local lan
    lan="$(ipconfig getifaddr en0 2>/dev/null || true)"
    [[ -n "$lan" ]] && echo "  On iPhone:    ${SCHEME}://${lan}:${PORT}"
    echo "  Wake: say \"starra\" or press Option+Space"
    echo ""
  else
    echo ""
    echo "◆ Still offline. Use this safer command instead:"
    echo "  cd $PROJ"
    echo "  npm run starra"
    echo ""
    return 1
  fi
}

cmd_stop() {
  if [[ -f "$PID_FILE" ]]; then
    local pid
    pid="$(cat "$PID_FILE" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      echo "→ Stopping deck pid ${pid}…"
      kill "$pid" 2>/dev/null || true
      # also kill child next if present
      pkill -f "next dev.*${PORT}" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
  else
    pkill -f "next dev.*${PORT}" 2>/dev/null || true
  fi
  echo "● Deck stopped (Ollama left running)."
}

cmd_status() {
  if ollama_up; then echo "● Ollama"; else echo "○ Ollama"; fi
  if deck_up; then echo "● Deck $URL"; else echo "○ Deck"; fi
  local lan
  lan="$(ipconfig getifaddr en0 2>/dev/null || true)"
  [[ -n "$lan" ]] && echo "  iPhone: ${SCHEME}://${lan}:${PORT}"
  [[ -f "$LOG" ]] && echo "  log: $LOG"
}

cmd_install() {
  local dest="${HOME}/bin"
  mkdir -p "$dest"
  ln -sf "$PROJ/scripts/starra" "$dest/starra"
  chmod +x "$PROJ/scripts/starra"

  if ! grep -q 'HOME/bin' "${HOME}/.zshrc" 2>/dev/null; then
    echo 'export PATH="$HOME/bin:$PATH"' >> "${HOME}/.zshrc"
    echo "● Added ~/bin to ~/.zshrc"
  fi

  echo "● CLI: $dest/starra"
  echo "→ Building STARRA.app with icon…"
  bash "$PROJ/scripts/macos/install-app.sh"

  echo ""
  echo "Launch her:"
  echo "  • Double-click STARRA in Applications (or Spotlight: STARRA)"
  echo "  • Or: npm run starra"
  echo "Wake (after the page opens): allow mic, say \"starra\" or Option+Space."
}

usage() {
  cat <<EOF
starra — wake STARGATE

  starra          up + open browser
  starra up       start Ollama + deck (background)
  starra open     open HUD (starts if needed)
  starra stop     stop deck
  starra status   health
  starra install  PATH + double-click STARRA.command
EOF
}

# lipsync <gradio-url> — point her lip-sync at a fresh Colab JoyVASA endpoint.
# Colab links are ephemeral (die when the session times out), so re-running the
# notebook prints a NEW url; this is the one-line way to refresh it + enable
# lip-sync + restart the deck so it takes effect. `starra lipsync off` disables.
cmd_lipsync() {
  local url="${1:-}"
  local env="$PROJ/.env.local"
  touch "$env"
  # strip any existing COLAB_LIPSYNC_URL / NEXT_PUBLIC_LIPSYNC lines
  grep -vE '^(COLAB_LIPSYNC_URL|NEXT_PUBLIC_LIPSYNC)=' "$env" > "$env.tmp" 2>/dev/null || true
  mv "$env.tmp" "$env"
  if [[ -z "$url" || "$url" == "off" ]]; then
    printf 'COLAB_LIPSYNC_URL=\nNEXT_PUBLIC_LIPSYNC=0\n' >> "$env"
    echo "lip-sync OFF (using her fluid clips)."
  else
    printf 'COLAB_LIPSYNC_URL=%s\nNEXT_PUBLIC_LIPSYNC=1\n' "$url" >> "$env"
    echo "lip-sync ON -> $url"
  fi
  echo "restarting the deck so it picks up the change…"
  cmd_stop >/dev/null 2>&1 || true
  cmd_up
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    ""|open) cmd_open ;;
    up|start) cmd_up ;;
    stop|down) cmd_stop ;;
    status|st) cmd_status ;;
    install) cmd_install ;;
    lipsync) shift; cmd_lipsync "${1:-}" ;;
    -h|--help|help) usage ;;
    *)
      echo "Unknown: $cmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
